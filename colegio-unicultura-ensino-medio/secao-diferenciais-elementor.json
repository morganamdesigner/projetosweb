        {
          "id": "9231654",
          "elType": "widget",
          "isInner": false,
          "widgetType": "html",
          "settings": {
            "html": "<style>\n/* Entradas mais suaves: as animações nativas do Elementor deslocam 100% da\n   altura do elemento (ex.: 812px numa foto). Aqui o deslocamento é de 32px. */\n.gt-root .animated {\n  animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);\n}\n\n.gt-root .fadeInUp {\n  animation-name: gt-fade-in-up;\n}\n\n.gt-root .fadeInLeft {\n  animation-name: gt-fade-in-left;\n}\n\n.gt-root .zoomIn {\n  animation-name: gt-zoom-in;\n}\n\n@keyframes gt-fade-in-up {\n  from { opacity: 0; transform: translate3d(0, 32px, 0); }\n  to   { opacity: 1; transform: none; }\n}\n\n@keyframes gt-fade-in-left {\n  from { opacity: 0; transform: translate3d(-32px, 0, 0); }\n  to   { opacity: 1; transform: none; }\n}\n\n@keyframes gt-zoom-in {\n  from { opacity: 0; transform: scale(0.9); }\n  to   { opacity: 1; transform: none; }\n}\n\n/* Títulos das seções: \"cortina\" da esquerda para a direita ao entrar na tela */\n.un-reveal.animated .elementor-heading-title {\n  animation: un-reveal 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;\n}\n\n@keyframes un-reveal {\n  from { clip-path: inset(0 100% 0 0); transform: translateX(-12px); }\n  to   { clip-path: inset(0 0 0 0); transform: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .un-reveal.animated .elementor-heading-title {\n    animation: none;\n  }\n}\n\n/* Botões com seta em círculo vermelho (gira no hover) */\n.un-btn-arrow .elementor-button-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  background-color: #F10505;\n  color: #FFFFFF;\n  fill: #FFFFFF;\n  font-size: 12px;\n  transition: transform 0.4s ease;\n}\n\n.un-btn-arrow .elementor-button-icon svg {\n  width: 1em;\n  height: 1em;\n  fill: currentColor;\n}\n\n.un-btn-arrow .elementor-button-icon i,\n.un-btn-arrow .elementor-button-icon svg {\n  transform: rotate(-45deg);\n}\n\n.un-btn-arrow .elementor-button:hover .elementor-button-icon {\n  transform: rotate(45deg);\n}\n\n/* --------------------------------------------------------------------------\n   DIFERENCIAIS: cartão azul (luz suave + grade de pontos) + 3 cards\n   -------------------------------------------------------------------------- */\n\n.un-diferenciais .un-dif-card {\n  position: relative;\n  isolation: isolate;\n}\n\n/* Brilho laranja/vermelho em movimento lento no canto do cartão */\n.un-diferenciais .un-dif-card::before {\n  content: \"\";\n  position: absolute;\n  top: -30%;\n  right: -25%;\n  z-index: -1;\n  width: 70%;\n  height: auto; /* o Elementor força 100% no ::before dos containers */\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(255, 184, 103, 0.35), rgba(241, 5, 5, 0.12) 45%, transparent 70%);\n  animation: un-glow 12s ease-in-out infinite alternate;\n  pointer-events: none;\n}\n\n/* Grade de pontos discreta, sumindo para a esquerda */\n.un-diferenciais .un-dif-card::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1.2px, transparent 1.2px);\n  background-size: 22px 22px;\n  -webkit-mask-image: linear-gradient(250deg, #000 10%, transparent 60%);\n  mask-image: linear-gradient(250deg, #000 10%, transparent 60%);\n  pointer-events: none;\n}\n\n@keyframes un-glow {\n  from { transform: translate(0, 0) scale(1); }\n  to   { transform: translate(-18%, 22%) scale(1.15); }\n}\n\n/* Cards: sobem no hover, o ícone vira azul e gira, uma barra vermelha aparece à esquerda */\n.un-diferenciais .un-dif-tile {\n  position: relative;\n  overflow: hidden;\n  transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.45s ease;\n}\n\n.un-diferenciais .un-dif-tile::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 4px;\n  height: 100%;\n  border: 0; /* o ::before dos containers herda a borda do card no Elementor */\n  background: linear-gradient(180deg, #F10505, #FF5A36);\n  transform: scaleY(0);\n  transform-origin: 50% 0;\n  transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);\n}\n\n.un-diferenciais .un-dif-icon .elementor-icon {\n  transition: background-color 0.4s ease, color 0.4s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n@media (hover: hover) {\n  .un-diferenciais .un-dif-tile:hover {\n    transform: translateX(6px);\n    box-shadow: 0 18px 40px rgba(1, 6, 88, 0.1);\n  }\n\n  .un-diferenciais .un-dif-tile:hover::before {\n    transform: scaleY(1);\n  }\n\n  .un-diferenciais .un-dif-tile:hover .un-dif-icon .elementor-icon {\n    background-color: #010658;\n    color: #FFFFFF;\n    fill: #FFFFFF;\n    transform: rotate(-10deg) scale(1.06);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .un-diferenciais .un-dif-card::before {\n    animation: none;\n  }\n}\n</style>"
          },
