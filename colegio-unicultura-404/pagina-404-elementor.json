            {
              "id": "6d0ea86",
              "elType": "widget",
              "isInner": false,
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"un-404-art\" role=\"img\" aria-label=\"Erro 404\"><span class=\"un-404-glow\"></span><span class=\"un-404-dot un-404-dot--1\"></span><span class=\"un-404-dot un-404-dot--2\"></span><span class=\"un-404-dot un-404-dot--3\"></span><span class=\"un-404-dot un-404-dot--4\"></span><span class=\"un-404-digit\">4</span><span class=\"un-404-compass\"><span class=\"un-404-ring\"></span><span class=\"un-404-ticks\"><i></i><i></i><i></i><i></i></span><span class=\"un-404-needle\"><svg viewBox=\"0 0 20 60\"><path d=\"M10 0L20 30H0z\" fill=\"#F10505\"/><path d=\"M0 30h20L10 60z\" fill=\"#FFFFFF\"/></svg></span><span class=\"un-404-pin\"></span></span><span class=\"un-404-digit\">4</span></div>\n<style>\n/* Colégio Unicultura | Página 404 - vai DENTRO do widget HTML da própria página.\n   Escopo: .un-404   A agulha da bússola (o \"0\") procura o caminho e aponta para o botão\n   \"Voltar para a Home\"; passando o mouse num link, ela aponta para ele (un-404.js). */\n\n.un-404 {\n  overflow: hidden;\n}\n\n/* \"4 [bússola] 4\" */\n.un-404-art {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.06em;\n  color: #FFFFFF;\n  font: 800 clamp(120px, 20vw, 240px)/1 \"Hanken Grotesk\", sans-serif;\n  letter-spacing: -0.04em;\n  user-select: none;\n}\n\n.un-404-digit {\n  display: block;\n  animation: un404-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;\n}\n\n.un-404-digit:last-child {\n  animation-delay: 0.15s;\n}\n\n/* A bússola no lugar do zero */\n.un-404-compass {\n  position: relative;\n  width: 0.74em;\n  height: 0.74em;\n  margin: 0 0.04em;\n  border: 0.07em solid #FFFFFF;\n  border-radius: 50%;\n  animation: un404-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.08s both, un404-bob 5s ease-in-out 1s infinite;\n}\n\n/* anel tracejado girando devagar */\n.un-404-ring {\n  position: absolute;\n  inset: -0.12em;\n  border: 2px dashed rgba(255, 255, 255, 0.22);\n  border-radius: 50%;\n  animation: un404-spin 30s linear infinite;\n}\n\n/* marcas N / L / S / O */\n.un-404-ticks {\n  position: absolute;\n  inset: 0;\n}\n\n.un-404-ticks i {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 0.03em;\n  height: 0.07em;\n  margin: -0.035em 0 0 -0.015em;\n  border-radius: 2px;\n  background: rgba(255, 255, 255, 0.55);\n}\n\n.un-404-ticks i:nth-child(1) { transform: rotate(0deg)   translateY(-0.26em); }\n.un-404-ticks i:nth-child(2) { transform: rotate(90deg)  translateY(-0.26em); }\n.un-404-ticks i:nth-child(3) { transform: rotate(180deg) translateY(-0.26em); }\n.un-404-ticks i:nth-child(4) { transform: rotate(270deg) translateY(-0.26em); }\n\n.un-404-needle {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 0.14em;\n  height: 0.46em;\n  margin: -0.23em 0 0 -0.07em;\n  transform: rotate(var(--un-404-a, 0deg));\n  transition: transform 1.1s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.un-404-needle svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n}\n\n.un-404.is-seeking .un-404-needle {\n  animation: un404-seek 2.6s ease-in-out both;\n}\n\n.un-404-pin {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 0.07em;\n  height: 0.07em;\n  margin: -0.035em 0 0 -0.035em;\n  border-radius: 50%;\n  background: #FFFFFF;\n  box-shadow: 0 0 0 0.015em #010658;\n}\n\n/* Brilho vermelho suave atrás do número */\n.un-404-glow {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  z-index: -1;\n  width: 3.2em;\n  height: 1.6em;\n  border-radius: 50%;\n  background: radial-gradient(closest-side, rgba(241, 5, 5, 0.28), rgba(241, 5, 5, 0));\n  transform: translate(-50%, -50%);\n  pointer-events: none;\n}\n\n/* Pontinhos flutuando */\n.un-404-dot {\n  position: absolute;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.5);\n  animation: un404-bob 6s ease-in-out infinite;\n}\n\n.un-404-dot--1 { top: 6%;  left: 8%;  width: 10px; height: 10px; }\n.un-404-dot--2 { top: 78%; left: 14%; width: 6px;  height: 6px; animation-delay: -2s; }\n.un-404-dot--3 { top: 12%; right: 10%; width: 8px; height: 8px; background: #F10505; animation-delay: -4s; }\n.un-404-dot--4 { bottom: 4%; right: 16%; width: 12px; height: 12px; background: rgba(255, 255, 255, 0.25); animation-delay: -1s; }\n\n@keyframes un404-in {\n  from { opacity: 0; transform: translateY(40px) scale(0.9); }\n  to   { opacity: 1; transform: none; }\n}\n\n@keyframes un404-bob {\n  0%, 100% { translate: 0 0; }\n  50%      { translate: 0 -10px; }\n}\n\n@keyframes un404-spin {\n  to { transform: rotate(360deg); }\n}\n\n/* a agulha \"procura\" o caminho antes de apontar */\n@keyframes un404-seek {\n  0%   { transform: rotate(-60deg); }\n  25%  { transform: rotate(80deg); }\n  45%  { transform: rotate(-35deg); }\n  65%  { transform: rotate(30deg); }\n  82%  { transform: rotate(-10deg); }\n  100% { transform: rotate(var(--un-404-a, 0deg)); }\n}\n\n/* Título: marca-texto vermelho suave (o texto continua branco) */\n.un-404 .un-mark-red {\n  background: linear-gradient(transparent 62%, rgba(241, 5, 5, 0.55) 62%) no-repeat 0 0 / 100% 100%;\n}\n\n/* Botões: seta que avança no hover */\n.un-404 .elementor-button-icon {\n  transition: transform 0.3s ease;\n}\n\n.un-404 .elementor-button:hover .elementor-button-icon {\n  transform: translateX(4px);\n}\n\n.un-404 .un-404-pill .elementor-button {\n  transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;\n}\n\n.un-404 .un-404-pill .elementor-button:hover,\n.un-404 .un-404-pill .elementor-button:focus-visible {\n  transform: translateY(-3px);\n}\n\n@media (max-width: 767px) {\n  .un-404-art {\n    font-size: 34vw;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .un-404-digit,\n  .un-404-compass,\n  .un-404-ring,\n  .un-404-dot,\n  .un-404.is-seeking .un-404-needle {\n    animation: none;\n  }\n\n  .un-404-needle {\n    transition: none;\n  }\n}\n</style>\n<script>\n/* Colégio Unicultura | Página 404 (CSS em un-404.css).\n   A agulha da bússola \"procura\" o caminho e depois aponta para o botão \"Voltar para a Home\".\n   Com o mouse (ou o foco do teclado) num botão/link da página, ela aponta para ele. */\n(function () {\n  var script = document.currentScript;\n  var page = script && script.closest('.un-404');\n  var needle = page && page.querySelector('.un-404-needle');\n  if (!needle) {\n    return;\n  }\n  var home = null;  // o botão vem depois deste widget: procurado quando a página carrega\n  var current = 0;\n\n  function pointTo(target) {\n    if (!target) {\n      return;\n    }\n    var n = needle.getBoundingClientRect();\n    var t = target.getBoundingClientRect();\n    var dx = t.left + t.width / 2 - (n.left + n.width / 2);\n    var dy = t.top + t.height / 2 - (n.top + n.height / 2);\n    var angle = Math.atan2(dx, -dy) * 180 / Math.PI;\n    // gira pelo caminho mais curto\n    while (angle - current > 180) { angle -= 360; }\n    while (angle - current < -180) { angle += 360; }\n    current = angle;\n    page.style.setProperty('--un-404-a', angle.toFixed(1) + 'deg');\n  }\n\n  function pointHome() {\n    pointTo(home);\n  }\n\n  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  function start() {\n    home = page.querySelector('.un-404-home .elementor-button');\n    page.querySelectorAll('.elementor-button').forEach(function (btn) {\n      btn.addEventListener('pointerenter', function () { pointTo(btn); });\n      btn.addEventListener('focus', function () { pointTo(btn); });\n      btn.addEventListener('pointerleave', pointHome);\n      btn.addEventListener('blur', pointHome);\n    });\n    pointHome();\n    if (!reduceMotion) {\n      page.classList.add('is-seeking');\n      needle.addEventListener('animationend', function () {\n        page.classList.remove('is-seeking');\n      }, { once: true });\n    }\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', start);\n  } else {\n    start();\n  }\n  window.addEventListener('load', pointHome);\n  window.addEventListener('resize', pointHome);\n})();\n</script>",
                "_css_classes": "un-404-art-wrap",
                "_animation": "fadeIn",
                "animation_duration": "fast"
