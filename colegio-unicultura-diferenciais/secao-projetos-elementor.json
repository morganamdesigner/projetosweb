            },
            "css_classes": "un-steps"
          },
          "elements": [
            {
              "id": "9860a6d",
              "elType": "widget",
              "isInner": false,
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"un-steps-fill\"></div>\n<style>\n/* Colégio Unicultura | Diferenciais - 07 Projetos: linha das etapas.\n   Vai DENTRO do widget da linha (a seção funciona sozinha, sem depender do CSS do topo).\n   --un-p (0 a 1) e .is-on vêm do un-projetos.js. Sem JS (e no editor) fica tudo aceso. */\n\n.un-steps {\n  position: relative;\n}\n\n.un-steps > .un-step {\n  position: relative;\n  z-index: 1;\n}\n\n/* O widget da linha sai do fluxo: fica atrás das etapas, do centro da 1ª bolinha ao centro da 3ª */\nbody .un-steps > .elementor-element.un-steps-line {\n  position: absolute !important;\n  top: 37px;\n  left: 30px;\n  right: calc((100% - 48px) / 3 - 30px);\n  z-index: 0;\n  width: auto !important;\n  max-width: none !important;\n  height: 2px;\n  margin: 0 !important;\n  padding: 0 !important;\n  border-radius: 2px;\n  background: rgba(255, 255, 255, 0.14);\n  pointer-events: none;\n}\n\n.un-steps-line .elementor-widget-container {\n  height: 100%;\n  margin: 0;\n  padding: 0;\n}\n\n.un-steps-fill {\n  width: 100%;\n  height: 100%;\n  border-radius: 2px;\n  background: linear-gradient(90deg, #F10505, #FFB867);\n  transform: scaleX(var(--un-p, 1));\n  transform-origin: 0 50%;\n  transition: transform 0.15s linear;\n}\n\n/* Bolinhas numeradas */\n.un-step .un-step-dot .elementor-heading-title {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 60px;\n  height: 60px;\n  border-radius: 50%;\n  background-color: #F10505;\n  box-shadow: 0 0 0 8px #010658, 0 0 0 9px rgba(241, 5, 5, 0.55), 0 0 28px rgba(241, 5, 5, 0.45);\n  transition: background-color 0.5s ease, box-shadow 0.5s ease, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.un-step .elementor-widget-heading:not(.un-step-dot) {\n  transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);\n}\n\n/* Etapa que a linha ainda não alcançou: apagada (.un-steps--js é posto pelo script) */\n.un-steps--js .un-step:not(.is-on) .un-step-dot .elementor-heading-title {\n  background-color: #1A1F6E;\n  box-shadow: 0 0 0 8px #010658, 0 0 0 9px rgba(255, 255, 255, 0.18);\n  transform: scale(0.82);\n}\n\n.un-steps--js .un-step:not(.is-on) .elementor-widget-heading:not(.un-step-dot) {\n  opacity: 0.3;\n  transform: translate3d(0, 10px, 0);\n}\n\n/* Celular: etapas em coluna, a linha desce */\n@media (max-width: 767px) {\n  body .un-steps > .elementor-element.un-steps-line {\n    top: 38px;\n    bottom: 30px;\n    left: 29px;\n    right: auto;\n    width: 2px !important;\n    height: auto;\n  }\n\n  .un-steps-fill {\n    background: linear-gradient(180deg, #F10505, #FFB867);\n    transform: scaleY(var(--un-p, 1));\n    transform-origin: 50% 0;\n  }\n}\n</style>\n<script>\n/* Colégio Unicultura | Diferenciais - 07 Projetos (CSS em un-projetos.css).\n   A linha (--un-p) se preenche enquanto as etapas sobem de 85% a 35% da tela,\n   e cada etapa acende (.is-on) quando a linha chega nela. Volta ao rolar para cima.\n   Não roda no editor do Elementor nem com \"reduzir movimento\" (fica tudo aceso). */\n(function () {\n  var script = document.currentScript;\n  if (document.body.classList.contains('elementor-editor-active')) {\n    return;\n  }\n  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n    return;\n  }\n  var block = script && script.closest('.un-steps');\n  if (!block || block.classList.contains('un-steps--js')) {\n    return;\n  }\n  block.classList.add('un-steps--js');\n  var ticking = false;\n\n  function update() {\n    ticking = false;\n    var vh = window.innerHeight;\n    var top = block.getBoundingClientRect().top;\n    var p = Math.max(0, Math.min(1, (vh * 0.85 - top) / (vh * 0.5)));\n    block.style.setProperty('--un-p', p.toFixed(3));\n    var items = block.querySelectorAll('.un-step');\n    items.forEach(function (item, i) {\n      var at = items.length > 1 ? i / (items.length - 1) : 0;\n      item.classList.toggle('is-on', p > 0 && p >= at - 0.02);\n    });\n  }\n\n  function requestUpdate() {\n    if (!ticking) {\n      ticking = true;\n      window.requestAnimationFrame(update);\n    }\n  }\n\n  // as etapas vêm depois deste widget no HTML: começa quando a página terminar de carregar\n  function start() {\n    update();\n    window.addEventListener('scroll', requestUpdate, { passive: true });\n    window.addEventListener('resize', requestUpdate);\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', start);\n  } else {\n    start();\n  }\n})();\n</script>",
                "_css_classes": "un-steps-line"
              },
              "elements": []
            },
